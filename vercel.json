{\n  "version": 2,\n  "builds": [\n    {\n      "src": "*.php",\n      "use": "vercel-php@0.7.1"\n    },\n    {\n      "src": "partials/*.php",\n      "use": "vercel-php@0.7.1"\n    },\n    {\n      "src": "*.css",\n      "use": "@vercel/static"\n    },\n    {\n      "src": "*.js",\n      "use": "@vercel/static"\n    },\n    {\n      "src": "*.png",\n      "use": "@vercel/static"\n    },\n    {\n      "src": "*.jpg",\n      "use": "@vercel/static"\n    }\n  ],\n  "routes": [\n    {\n      "src": "/(.*)",\n      "dest": "/$1"\n    }\n  ]\n}
